generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String              @id @default(cuid())
  name               String
  createdAt          DateTime            @default(now())
  users              User[]
  pipelines          Pipeline[]
  leads              Lead[]
  contacts           Contact[]
  companies          Company[]
  salesBots          SalesBot[]
  whatsappConfigs    WhatsAppConfig[]
  metaLeadsConfig    MetaLeadsConfig?
  agentConfig        AgentConfig?
  whatsappNumbers    WhatsAppNumber[]
  googleConnection   GoogleConnection?
  fieldDefinitions   FieldDefinition[]
  transactions       Transaction[]
  knowledgeFiles     KnowledgeFile[]
  assistantQuestions AssistantQuestion[]
  messageTemplates   MessageTemplate[]
  departments        Department[]
}

// Linha de negócio (ex: "Financiamento Habitacional", "Consórcio"). Cada
// colaborador não-admin enxerga só o que pertence ao SEU departamento —
// funil, leads, inbox/WhatsApp, tarefas, dashboard. Admin sempre vê tudo
// (departmentId não é levado em conta pra ele). Lista editável em
// Configurações → Departamentos.
model Department {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  // Produtos/linhas que a IA do WhatsApp (Lead.aiAutoReplyActive) atende
  // dentro deste setor — texto livre, ex.: "financiamento habitacional, home
  // equity, financiamento para construção". Fora disso ela não responde
  // sozinha, só avisa que vai chamar alguém da equipe. Editável em
  // Configurações → Setores.
  aiScope   String?

  pipelines        Pipeline[]
  whatsappNumbers  WhatsAppNumber[]
  whatsappConfigs  WhatsAppConfig[]
  messageTemplates MessageTemplate[]

  @@index([accountId])
}

model FieldDefinition {
  id        String    @id @default(cuid())
  accountId String
  tab       String    @default("Principal")
  name      String
  key       String
  type      FieldType @default(TEXT)
  options   String[]
  order     Int       @default(0)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([accountId])
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  EMAIL
  PHONE
  LINK
}

model User {
  id                         String              @id @default(cuid())
  name                       String
  email                      String              @unique
  password                   String
  role                       Role                @default(AGENT)
  accountId                  String
  account                    Account             @relation(fields: [accountId], references: [id])
  leads                      Lead[]
  tasks                      Task[]
  notes                      Note[]
  transactions               Transaction[]
  messagesSent               Message[]
  themeColor                 String              @default("white")
  themeImage                 String?
  themeOpacity               Int                 @default(85)
  // Número de WhatsApp (QR) que o usuário opera — usado para dividir os
  // clientes por usuário no Relatório Matinal. Mutuamente exclusivo com
  // operatesApiOficial (o seletor na tela é um só: QR específico OU API
  // Oficial, nunca os dois).
  whatsAppNumberId           String?
  whatsAppNumber             WhatsAppNumber?     @relation(fields: [whatsAppNumberId], references: [id])
  // true = o usuário opera pela API Oficial (não por um número QR
  // específico) — o Relatório Matinal busca os clientes que falaram pela
  // API dentro do SETOR dele, em vez de por whatsAppNumberId.
  operatesApiOficial         Boolean             @default(false)
  // Permissões por usuário (as "caixinhas"): { chave: boolean }. Null = usa o
  // padrão do papel. Admin sempre tem tudo. Ver src/lib/permissions.ts.
  permissions                Json?
  // Setores/linhas de negócio do colaborador (ex: Financiamento Habitacional,
  // Consórcio) — define o que ele enxerga (funil, inbox, tarefas, dashboard).
  // Pode pertencer a mais de um. Array vazio = sem setor definido ainda (por
  // ora, enxerga tudo — evita travar quem ainda não foi configurado). Admin
  // sempre vê tudo, tenha setor ou não. Sem relação formal (Department[])
  // de propósito — mesmo padrão de Lead.tags/FieldDefinition.options, não
  // precisa de metadado por vínculo (ver department.service.ts).
  departmentIds              String[]            @default([])
  createdAt                  DateTime            @default(now())
  assistantQuestionsAsked    AssistantQuestion[] @relation("AssistantQuestionAskedBy")
  assistantQuestionsReceived AssistantQuestion[] @relation("AssistantQuestionTarget")
}

enum Role {
  ADMIN
  MANAGER
  AGENT
}

model Pipeline {
  id           String      @id @default(cuid())
  name         String
  accountId    String
  account      Account     @relation(fields: [accountId], references: [id])
  stages       Stage[]
  leads        Lead[]
  // Setor dono deste funil — null = pipeline "antiga", visível pra todo
  // mundo (compatibilidade); pipelines novas devem sempre ter um setor.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
}

model Stage {
  id         String   @id @default(cuid())
  name       String
  color      String   @default("#888780")
  order      Int
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id])
  leads      Lead[]
}

model Lead {
  id                 String              @id @default(cuid())
  name               String
  value              Float?
  status             LeadStatus          @default(OPEN)
  pipelineId         String
  pipeline           Pipeline            @relation(fields: [pipelineId], references: [id])
  stageId            String
  stage              Stage               @relation(fields: [stageId], references: [id])
  userId             String
  user               User                @relation(fields: [userId], references: [id])
  contactId          String?
  contact            Contact?            @relation(fields: [contactId], references: [id])
  companyId          String?
  company            Company?            @relation(fields: [companyId], references: [id])
  accountId          String
  account            Account             @relation(fields: [accountId], references: [id])
  whatsappNumberId   String?
  whatsappNumber     WhatsAppNumber?     @relation(fields: [whatsappNumberId], references: [id])
  customFields       Json?
  tags               String[]
  archived           Boolean             @default(false)
  isGroup            Boolean             @default(false)
  // Assistente de IA responde o cliente SOZINHO nesta conversa (sem revisão
  // humana antes de enviar) — ligado/desligado por um botão na Inbox. Usa a
  // Base de Conhecimento; nunca inventa valor/prazo/promessa específica.
  aiAutoReplyActive  Boolean             @default(false)
  tasks              Task[]
  notes              Note[]
  messages           Message[]
  assistantQuestions AssistantQuestion[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
}

// Pergunta que um colaborador pede para o assistente fazer a OUTRO colaborador,
// sobre um lead específico (ex.: "pergunta pra Andreia qual o banco desse
// cliente"). Fica pendente até o destinatário responder no próprio chat dele
// com o assistente — a resposta preenche o campo do card automaticamente.
model AssistantQuestion {
  id            String    @id @default(cuid())
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  askedByUserId String
  askedBy       User      @relation("AssistantQuestionAskedBy", fields: [askedByUserId], references: [id])
  targetUserId  String
  targetUser    User      @relation("AssistantQuestionTarget", fields: [targetUserId], references: [id])
  leadId        String
  lead          Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // Chave do campo a preencher: "nome"/"valor" (campos nativos do card) ou
  // qualquer chave de FieldDefinition (customFields).
  campo         String
  pergunta      String
  resposta      String?
  answered      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  answeredAt    DateTime?

  @@index([accountId, targetUserId, answered])
}

// Templates de mensagem ("Respostas rápidas") — compartilhados pela conta
// inteira (visíveis pra qualquer colaborador e pro servidor). Opcionalmente
// dispara sozinho quando uma mensagem RECEBIDA no WhatsApp começa com
// triggerText (ex.: a saudação de um anúncio/site) — ver message.service.ts.
model MessageTemplate {
  id            String      @id @default(cuid())
  accountId     String
  account       Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name          String
  category      String      @default("geral")
  body          String
  variables     String[]
  triggerText   String?
  triggerActive Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  // Setor dono deste template — null = "compartilhado" (todo mundo vê,
  // como já era antes dos departamentos existirem).
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])

  @@index([accountId])
  @@index([accountId, triggerActive])
  @@index([departmentId])
}

enum LeadStatus {
  OPEN
  WON
  LOST
}

model Contact {
  id            String   @id @default(cuid())
  name          String
  email         String?
  phone         String?
  whatsappPhone String?
  avatar        String? // URL da foto de perfil (WhatsApp ou outro)
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id])
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id])
  leads         Lead[]
  createdAt     DateTime @default(now())
}

model Company {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  accountId String
  account   Account   @relation(fields: [accountId], references: [id])
  contacts  Contact[]
  leads     Lead[]
}

model Task {
  id     String   @id @default(cuid())
  title  String
  dueAt  DateTime
  done   Boolean  @default(false)
  userId String
  user   User     @relation(fields: [userId], references: [id])
  leadId String?
  lead   Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Note {
  id        String   @id @default(cuid())
  content   String
  type      NoteType @default(COMMENT)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum NoteType {
  COMMENT
  CALL
  EMAIL
  STAGE_CHANGE
  DATA_EDIT
}

model Message {
  id                    String              @id @default(cuid())
  content               String
  direction             Direction
  channel               Channel
  leadId                String
  lead                  Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  whatsappNumberId      String?
  whatsappNumber        WhatsAppNumber?     @relation(fields: [whatsappNumberId], references: [id])
  // Usuário do CRM que enviou a mensagem (só para as enviadas pela Inbox).
  sentByUserId          String?
  sentBy                User?               @relation(fields: [sentByUserId], references: [id])
  // Nome de quem enviou, quando é grupo (o participante que mandou a mensagem).
  senderName            String?
  read                  Boolean             @default(false)
  externalId            String?
  status                MsgStatus           @default(SENT)
  // Motivo do erro quando status = FAILED (vem do webhook de status da Meta,
  // API Oficial) — sem isso, uma falha de envio ficava sem explicação nenhuma.
  statusError           String?
  attachments           MessageAttachment[]
  createdAt             DateTime            @default(now())
  // Preenchido quando esta mensagem foi ENCAMINHADA de outra conversa. Guarda
  // o nome do lead de origem "congelado" no momento do envio (não é uma
  // relação de verdade — sobrevive mesmo se aquele lead for excluído depois).
  forwardedFromLeadId   String?
  forwardedFromLeadName String?
  // Preenchido quando esta mensagem é um CONTATO compartilhado no WhatsApp
  // (cartão de contato/vCard, não texto nem mídia) — dá pra "Conversar" ou
  // "Criar lead" direto com esse número, sem digitar nada.
  sharedContactName     String?
  sharedContactPhone    String?
  // Preenchido quando esta mensagem é uma RESPOSTA com citação a outra
  // mensagem da mesma conversa (como no WhatsApp) — guarda o conteúdo da
  // mensagem original "congelado" no momento do envio, não é uma relação de
  // verdade (sobrevive mesmo se a mensagem original for excluída depois).
  replyToExternalId     String?
  replyToContent        String?
  replyToSender         String?
}

// Documento/imagem recebido no WhatsApp (guardado até ir para o Drive)
model MessageAttachment {
  id          String   @id @default(cuid())
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  leadId      String
  fileName    String
  mimeType    String
  data        Bytes? // bytes do arquivo; limpo após subir ao Drive
  driveFileId String? // preenchido quando enviado ao Drive
  createdAt   DateTime @default(now())

  @@index([leadId])
}

enum MsgStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

// Um WhatsAppConfig por DEPARTAMENTO (não mais um por conta) — cada setor
// pode ter seu próprio número na API Oficial da Meta (ex: Financiamento
// Habitacional e Consórcio). departmentId null = config "antiga"/genérica,
// de uma conta que ainda não tinha departamentos quando configurou.
model WhatsAppConfig {
  id            String      @id @default(cuid())
  accountId     String
  account       Account     @relation(fields: [accountId], references: [id])
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  phoneNumberId String
  accessToken   String
  verifyToken   String      @default("af_crm_verify")
  active        Boolean     @default(false)
  wabaId        String? // ID da conta do WhatsApp Business (WABA) — salvo em "Ativar recebimento", reaproveitado para templates
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([accountId, departmentId])
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum Channel {
  WHATSAPP
  INSTAGRAM
  TELEGRAM
  WEBCHAT
  EMAIL
}

model MetaLeadsConfig {
  id              String   @id @default(cuid())
  accountId       String   @unique
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  verifyToken     String   @default("af_meta_verify")
  pageAccessToken String   @default("")
  defaultStageId  String?
  defaultUserId   String?
  active          Boolean  @default(true)
  fieldMappings   Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BaileysSession {
  id        String   @id @default(cuid())
  accountId String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Conexão com o Google Drive (OAuth) por conta
model GoogleConnection {
  id             String    @id @default(cuid())
  accountId      String    @unique
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email          String? // e-mail da conta Google conectada
  refreshToken   String    @db.Text
  accessToken    String?   @db.Text
  expiresAt      DateTime?
  rootFolderId   String? // pasta-raiz onde ficam as pastas dos clientes
  rootFolderName String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Cada número de WhatsApp conectado via QR Code (multi-sessão por conta)
model WhatsAppNumber {
  id           String      @id @default(cuid())
  accountId    String
  account      Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  label        String // apelido definido pelo usuário (ex: "Vendas", "Suporte")
  phone        String? // número real, preenchido quando conecta
  session      Json? // credenciais Baileys desta sessão
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  leads        Lead[]
  messages     Message[]
  users        User[]
  // Setor dono deste número — mensagens recebidas nele criam o lead já no
  // funil "Caixa de Entrada" DESSE setor. Null = número "antigo"/compartilhado.
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  @@index([accountId])
  @@index([departmentId])
}

model AgentConfig {
  id                  String   @id @default(cuid())
  accountId           String   @unique
  account             Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  systemPrompt        String   @db.Text
  // Pasta do Google Drive usada como Base de Conhecimento (treinamento do assistente).
  knowledgeFolderId   String?
  knowledgeFolderName String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Base de Conhecimento: um arquivo (Word/PDF/Google Doc) da pasta do Drive.
/// Só material genérico da empresa — nunca dados de cliente.
model KnowledgeFile {
  id           String           @id @default(cuid())
  accountId    String
  account      Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  driveFileId  String
  name         String
  mimeType     String
  modifiedTime String? // modifiedTime do Drive — p/ re-sincronizar só o que mudou
  chunkCount   Int              @default(0)
  status       String           @default("pending") // pending | indexed | error
  error        String?          @db.Text
  indexedAt    DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  chunks       KnowledgeChunk[]

  @@unique([accountId, driveFileId])
  @@index([accountId])
}

/// Um pedaço de texto de um documento + seu embedding (vetor de significado).
model KnowledgeChunk {
  id         String        @id @default(cuid())
  accountId  String
  fileId     String
  file       KnowledgeFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String        @db.Text
  embedding  Float[] // vetor gerado pela Voyage
  createdAt  DateTime      @default(now())

  @@index([accountId])
  @@index([fileId])
}

// flow guarda { trigger: { keywords: string[] }, steps: BotStep[] } — ver
// apps/web/components/salesbot/node-types.tsx pro formato exato de BotStep.
model SalesBot {
  id          String        @id @default(cuid())
  name        String
  description String?
  active      Boolean       @default(false)
  flow        Json
  accountId   String
  account     Account       @relation(fields: [accountId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  runs        SalesBotRun[]

  @@index([accountId])
}

enum SalesBotRunStatus {
  RUNNING
  WAITING_REPLY
  WAITING_TIME
  COMPLETED
  STOPPED
  ERROR
}

// Uma execução do fluxo de um SalesBot contra um lead específico. currentStepId
// aponta pro passo a executar/retomar; resumeAt tem sentido duplo conforme o
// status: em WAITING_TIME é quando retomar sozinho (poll periódico), em
// WAITING_REPLY é o prazo pra desistir se o lead não responder.
model SalesBotRun {
  id            String            @id @default(cuid())
  accountId     String
  salesBotId    String
  salesBot      SalesBot          @relation(fields: [salesBotId], references: [id])
  leadId        String
  status        SalesBotRunStatus @default(RUNNING)
  currentStepId String?
  resumeAt      DateTime?
  stopReason    String?
  startedAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  logs          SalesBotRunLog[]

  @@index([leadId])
  @@index([status, resumeAt])
}

// Auditoria passo a passo de uma execução — mesmo padrão de AgentActionLog
// (Agente de Navegador), pra dar visibilidade real do que o bot fez.
model SalesBotRunLog {
  id        String      @id @default(cuid())
  runId     String
  run       SalesBotRun @relation(fields: [runId], references: [id])
  stepId    String?
  stepType  String?
  detail    Json?
  createdAt DateTime    @default(now())

  @@index([runId])
}

enum TransactionType {
  INCOME
  EXPENSE
  SAVINGS
}

model Transaction {
  id                String          @id @default(cuid())
  description       String
  amount            Float
  type              TransactionType
  date              DateTime
  accountId         String
  account           Account         @relation(fields: [accountId], references: [id])
  userId            String?
  user              User?           @relation(fields: [userId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  // Lançamento fixo (repete todo mês sozinho). true só no "molde" original;
  // as ocorrências geradas automaticamente apontam pra ele via recurringParentId.
  isRecurring       Boolean         @default(false)
  recurringDay      Int? // dia do mês em que repete (1-31)
  recurringParentId String? // preenchido nas ocorrências geradas — aponta pro molde
}

enum CommissionSuggestionStatus {
  PENDING
  CONFIRMED
  DISMISSED
}

// Sugestão de comissão (ex: 1% do valor de crédito) gerada quando um lead é
// marcado como Ganho. Fica pendente até o usuário revisar/ajustar o valor e
// confirmar no Financeiro — só então vira uma Transaction de verdade. Usa
// leadId/accountId como campos simples (sem @relation), no mesmo padrão já
// usado em MessageAttachment.leadId, para não alterar os modelos Lead/Account.
model CommissionSuggestion {
  id              String                     @id @default(cuid())
  accountId       String
  leadId          String
  baseAmount      Float // valor do crédito usado como base do cálculo
  suggestedAmount Float // baseAmount * 1% — o valor sugerido (editável ao confirmar)
  status          CommissionSuggestionStatus @default(PENDING)
  transactionId   String? // preenchido quando confirmada
  createdAt       DateTime                   @default(now())
  resolvedAt      DateTime?

  @@index([accountId, status])
}

// Histórico do chat do Assistente AF CRM, por colaborador. messages guarda o
// array de { role, content } da conversa. Cada colaborador tem as suas.
model AssistantConversation {
  id        String   @id @default(cuid())
  accountId String
  userId    String
  title     String   @default("Nova conversa")
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum DashboardNoteScope {
  PRIVATE // só quem escreveu vê
  TEAM // mural — todos os colaboradores da conta veem
}

// Bloco de anotações do Dashboard ("o que tenho pra hoje"). PRIVATE é só do
// autor; TEAM é um mural compartilhado por toda a conta. Sem @relation com
// User/Account — mesmo padrão leve já usado em CommissionSuggestion.
model DashboardNote {
  id        String             @id @default(cuid())
  accountId String
  userId    String
  scope     DashboardNoteScope @default(PRIVATE)
  content   String
  done      Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([accountId, scope])
  @@index([userId])
}

enum AgentTaskStatus {
  PENDING // criada, ainda não começou a rodar
  RUNNING // loop de decisão em andamento
  AWAITING_APPROVAL // esperando aprovar/recusar uma ação sensível (ask_human kind=approval)
  AWAITING_ANSWER // esperando o operador responder uma pergunta (ask_human kind=question)
  AWAITING_HUMAN_TAKEOVER // esperando o humano fazer algo manualmente (ainda não usado — sem take-over de aba)
  COMPLETED
  FAILED
  CANCELLED
}

// Uma tarefa do Agente de Navegador — "emita a certidão X no ONR". Sem
// @relation com User/Account/Lead de propósito (mesmo padrão leve já usado em
// DashboardNote/AssistantConversation) — é registro de execução, não dado de
// negócio que precise de integridade referencial forte.
model AgentTask {
  id            String          @id @default(cuid())
  accountId     String
  userId        String // quem pediu — também quem aprova/recusa/cancela
  leadId        String? // opcional: pra qual cliente é essa tarefa
  instruction   String          @db.Text
  status        AgentTaskStatus @default(PENDING)
  // Histórico bruto no formato da API da Anthropic — permite depurar/retomar
  // a conversa exata que gerou cada ação. Podado a cada turno (só mantém as
  // últimas screenshots) pra não estourar o banco nem o custo de tokens.
  conversation  Json            @default("[]")
  pendingAction Json? // ação sensível aguardando decisão (Fase 2)
  resultSummary String?         @db.Text
  errorMessage  String?         @db.Text
  stepCount     Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  completedAt   DateTime?

  @@index([accountId, userId])
  @@index([status])
}

// Log de auditoria por passo — "por que ele clicou ali". Não guarda a
// screenshot em si (ficaria gigante rápido); só o que a IA decidiu e o
// resultado (ok/erro), nunca a imagem.
model AgentActionLog {
  id               String   @id @default(cuid())
  taskId           String
  seq              Int
  tool             String // browser_click, browser_navigate, browser_type...
  input            Json // argumentos que a IA passou (x, y, text, url, motivo...)
  output           Json? // resultado (sem a screenshot — só ok/erro/mensagem)
  requiredApproval Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([taskId, seq])
}

// Guia/"memória" de como navegar num site — gerado a partir de uma AgentTask
// concluída (generatePlaybookFromTask) ou escrito à mão. Injetado no system
// prompt de tarefas novas (ver buildSystemPromptForTask), igual um manual da
// Base de Conhecimento, mas dedicado ao Agente de Navegador e editável numa
// tela própria. Sem @relation de propósito — mesmo padrão leve de AgentTask/
// AgentActionLog, é conhecimento, não dado de negócio com integridade
// referencial forte.
model AgentPlaybook {
  id           String   @id @default(cuid())
  accountId    String
  domain       String // ex.: "ridigital.org.br" — extraído do 1º browser_navigate, editável depois
  title        String // ex.: "Emitir certidão de ônus"
  steps        String   @db.Text // o guia em texto, gerado pela IA, 100% editável
  active       Boolean  @default(true) // só os ativos entram no prompt de tarefas novas
  sourceTaskId String? // de qual AgentTask foi gerado — só auditoria/rastreio
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([accountId])
}
