generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id               String            @id @default(cuid())
  name             String
  createdAt        DateTime          @default(now())
  users            User[]
  pipelines        Pipeline[]
  leads            Lead[]
  contacts         Contact[]
  companies        Company[]
  salesBots        SalesBot[]
  whatsappConfig   WhatsAppConfig?
  metaLeadsConfig  MetaLeadsConfig?
  agentConfig      AgentConfig?
  whatsappNumbers  WhatsAppNumber[]
  googleConnection GoogleConnection?
  fieldDefinitions FieldDefinition[]
  transactions     Transaction[]
}

model FieldDefinition {
  id        String    @id @default(cuid())
  accountId String
  tab       String    @default("Principal")
  name      String
  key       String
  type      FieldType @default(TEXT)
  options   String[]
  order     Int       @default(0)
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([accountId])
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  EMAIL
  PHONE
  LINK
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(AGENT)
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  leads     Lead[]
  tasks     Task[]
  notes     Note[]
  transactions Transaction[]
  themeColor   String  @default("white")
  themeImage   String?
  themeOpacity Int     @default(85)
  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  MANAGER
  AGENT
}

model Pipeline {
  id        String   @id @default(cuid())
  name      String
  accountId String
  account   Account  @relation(fields: [accountId], references: [id])
  stages    Stage[]
  leads     Lead[]
}

model Stage {
  id         String   @id @default(cuid())
  name       String
  color      String   @default("#888780")
  order      Int
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id])
  leads      Lead[]
}

model Lead {
  id           String     @id @default(cuid())
  name         String
  value        Float?
  status       LeadStatus @default(OPEN)
  pipelineId   String
  pipeline     Pipeline   @relation(fields: [pipelineId], references: [id])
  stageId      String
  stage        Stage      @relation(fields: [stageId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  contactId    String?
  contact      Contact?   @relation(fields: [contactId], references: [id])
  companyId    String?
  company      Company?   @relation(fields: [companyId], references: [id])
  accountId    String
  account      Account    @relation(fields: [accountId], references: [id])
  whatsappNumberId String?
  whatsappNumber   WhatsAppNumber? @relation(fields: [whatsappNumberId], references: [id])
  customFields Json?
  tags         String[]
  archived     Boolean    @default(false)
  tasks        Task[]
  notes        Note[]
  messages     Message[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum LeadStatus {
  OPEN
  WON
  LOST
}

model Contact {
  id            String   @id @default(cuid())
  name          String
  email         String?
  phone         String?
  whatsappPhone String?
  avatar        String?  // URL da foto de perfil (WhatsApp ou outro)
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id])
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id])
  leads         Lead[]
  createdAt     DateTime @default(now())
}

model Company {
  id        String    @id @default(cuid())
  name      String
  email     String?
  phone     String?
  accountId String
  account   Account   @relation(fields: [accountId], references: [id])
  contacts  Contact[]
  leads     Lead[]
}

model Task {
  id        String   @id @default(cuid())
  title     String
  dueAt     DateTime
  done      Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  leadId    String?
  lead      Lead?    @relation(fields: [leadId], references: [id])
}

model Note {
  id        String   @id @default(cuid())
  content   String
  type      NoteType @default(COMMENT)
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum NoteType {
  COMMENT
  CALL
  EMAIL
  STAGE_CHANGE
  DATA_EDIT
}

model Message {
  id         String     @id @default(cuid())
  content    String
  direction  Direction
  channel    Channel
  leadId     String
  lead       Lead       @relation(fields: [leadId], references: [id])
  whatsappNumberId String?
  whatsappNumber   WhatsAppNumber? @relation(fields: [whatsappNumberId], references: [id])
  read       Boolean    @default(false)
  externalId String?
  status     MsgStatus  @default(SENT)
  createdAt  DateTime   @default(now())
}

enum MsgStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

model WhatsAppConfig {
  id            String   @id @default(cuid())
  accountId     String   @unique
  account       Account  @relation(fields: [accountId], references: [id])
  phoneNumberId String
  accessToken   String
  verifyToken   String   @default("af_crm_verify")
  active        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum Channel {
  WHATSAPP
  INSTAGRAM
  TELEGRAM
  WEBCHAT
  EMAIL
}

model MetaLeadsConfig {
  id              String   @id @default(cuid())
  accountId       String   @unique
  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  verifyToken     String   @default("af_meta_verify")
  pageAccessToken String   @default("")
  defaultStageId  String?
  defaultUserId   String?
  active          Boolean  @default(true)
  fieldMappings   Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BaileysSession {
  id        String   @id @default(cuid())
  accountId String   @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Conexão com o Google Drive (OAuth) por conta
model GoogleConnection {
  id            String   @id @default(cuid())
  accountId     String   @unique
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email         String?  // e-mail da conta Google conectada
  refreshToken  String   @db.Text
  accessToken   String?  @db.Text
  expiresAt     DateTime?
  rootFolderId  String?  // pasta-raiz onde ficam as pastas dos clientes
  rootFolderName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Cada número de WhatsApp conectado via QR Code (multi-sessão por conta)
model WhatsAppNumber {
  id        String    @id @default(cuid())
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  label     String    // apelido definido pelo usuário (ex: "Vendas", "Suporte")
  phone     String?   // número real, preenchido quando conecta
  session   Json?     // credenciais Baileys desta sessão
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  leads     Lead[]
  messages  Message[]

  @@index([accountId])
}

model AgentConfig {
  id           String   @id @default(cuid())
  accountId    String   @unique
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  systemPrompt String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SalesBot {
  id        String  @id @default(cuid())
  name      String
  active    Boolean @default(false)
  flow      Json
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
}

enum TransactionType {
  INCOME
  EXPENSE
  SAVINGS
}

model Transaction {
  id          String          @id @default(cuid())
  description String
  amount      Float
  type        TransactionType
  date        DateTime
  accountId   String
  account     Account         @relation(fields: [accountId], references: [id])
  userId      String?
  user        User?           @relation(fields: [userId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}
